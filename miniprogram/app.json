{
  "pages": [
    "pages/index/index",
    "pages/discover/discover",
    "pages/filter/filter",
    "pages/location-picker/location-picker"
  ],
  "window": {
    "backgroundTextStyle": "light",
    "navigationBarBackgroundColor": "#2d6a4f",
    "navigationBarTitleText": "渝趣周边游",
    "navigationBarTextStyle": "white",
    "backgroundColor": "#f0f7f4"
  },
  "tabBar": {
    "custom": true,
    "color": "#94a3b8",
    "selectedColor": "#2d6a4f",
    "backgroundColor": "#ffffff",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "路线",
        "iconPath": "images/home.png",
        "selectedIconPath": "images/home-active.png"
      },
      {
        "pagePath": "pages/discover/discover",
        "text": "探索",
        "iconPath": "images/discover.png",
        "selectedIconPath": "images/discover-active.png"
      },
      {
        "pagePath": "pages/filter/filter",
        "text": "筛选",
        "iconPath": "images/filter.png",
        "selectedIconPath": "images/filter-active.png"
      }
    ]
  },
  "permission": {
    "scope.userLocation": {
      "desc": "用于获取您的位置，推荐重庆周边徒步与游玩路线"
    }
  },
  "requiredPrivateInfos": ["getLocation", "chooseLocation"],
  "networkTimeout": {
    "request": 10000,
    "downloadFile": 10000
  },
  "subpackages": [
    {
      "root": "packageRoutes",
      "name": "routes",
      "pages": [
        "pages/route-detail/route-detail"
      ]
    }
  ],
  "preloadRule": {
    "pages/index/index": {
      "network": "wifi",
      "packages": ["routes"]
    }
  },
  "sitemapLocation": "sitemap.json",
  "style": "v2",
  "lazyCodeLoading": "requiredComponents",
  "debug": false,
  "navigateToMiniProgramAppIdList": []
}
