.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(12px);
  box-shadow: 0 -2rpx 24rpx rgba(196, 30, 42, 0.08);
  border-top: 1rpx solid rgba(196, 30, 42, 0.06);
}

.tab-bar__inner {
  display: flex;
  align-items: stretch;
  height: 110rpx;
  padding: 8rpx 16rpx 0;
}

.tab-bar__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  padding: 4rpx 0;
  transition: transform 0.2s ease;
}

.tab-bar__item--active {
  transform: translateY(-2rpx);
}

.tab-bar__icon-wrap {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  background: transparent;
  transition: background 0.2s ease;
}

.tab-bar__item--active .tab-bar__icon-wrap {
  background: linear-gradient(145deg, #fef2f2 0%, #fff5f5 100%);
  box-shadow: 0 4rpx 16rpx rgba(196, 30, 42, 0.12);
}

.tab-bar__icon {
  font-size: 40rpx;
  line-height: 1;
}

.tab-bar__text {
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 4rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
}

.tab-bar__item--active .tab-bar__text {
  color: #c41e2a;
  font-weight: 600;
}

.tab-bar__dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #c41e2a 0%, #e53e3e 100%);
  margin-top: 6rpx;
}

.tab-bar__safe {
  height: env(safe-area-inset-bottom);
  background: rgba(255, 255, 255, 0.96);
}
