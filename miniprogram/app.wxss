/* 全局样式 - 渝趣周边游主题设计 */
page {
  background-color: #f0f7f4;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
  font-size: 28rpx;
  color: #1e293b;
  line-height: 1.5;
}

/* 为自定义 TabBar 预留底部空间：栏高 110rpx + 安全区 */
.container {
  padding: 24rpx;
  padding-bottom: calc(130rpx + env(safe-area-inset-bottom));
  min-height: 100vh;
  box-sizing: border-box;
}

/* 主题色调 - 山野绿 */
.primary-color {
  color: #2d6a4f;
}

.primary-bg {
  background: linear-gradient(135deg, #1b4332 0%, #2d6a4f 100%);
}

/* 次要色调 - 火锅橙 */
.secondary-color {
  color: #dd6b20;
}

.secondary-bg {
  background: linear-gradient(135deg, #dd6b20 0%, #ed8936 100%);
}

/* 强调色 - 山城金 */
.accent-color {
  color: #d69e2e;
}

.accent-bg {
  background: linear-gradient(135deg, #d69e2e 0%, #ecc94b 100%);
}

/* 成功色 - 江水绿 */
.success-color {
  color: #38a169;
}

.success-bg {
  background: linear-gradient(135deg, #38a169 0%, #48bb78 100%);
}

/* 警告色 */
.warning-color {
  color: #dd6b20;
}

.warning-bg {
  background: linear-gradient(135deg, #dd6b20 0%, #ed8936 100%);
}

/* 错误色 */
.error-color {
  color: #e53e3e;
}

.error-bg {
  background: linear-gradient(135deg, #e53e3e 0%, #fc8181 100%);
}

/* 卡片设计 */
.card {
  background: white;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(27, 67, 50, 0.08);
  border: 1rpx solid rgba(45, 106, 79, 0.06);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1e293b;
  margin-bottom: 16rpx;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1e293b;
}

.card-subtitle {
  font-size: 26rpx;
  color: #64748b;
}

/* 按钮设计 */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 40rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
  transition: all 0.3s ease;
  border: none;
  gap: 12rpx;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, #1b4332 0%, #2d6a4f 100%);
  color: white;
}

.btn-primary:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.btn-secondary {
  background: linear-gradient(135deg, #dd6b20 0%, #ed8936 100%);
  color: white;
}

.btn-accent {
  background: linear-gradient(135deg, #d69e2e 0%, #ecc94b 100%);
  color: white;
}

.btn-outline {
  background: transparent;
  border: 2rpx solid #2d6a4f;
  color: #2d6a4f;
}

.btn-outline:active {
  background: #2d6a4f;
  color: white;
}

/* 标签设计 */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
}

.tag-primary {
  background: #f0f7f4;
  color: #2d6a4f;
}

.tag-secondary {
  background: #fffaf0;
  color: #dd6b20;
}

.tag-accent {
  background: #fffff0;
  color: #d69e2e;
}

.tag-success {
  background: #f0fff4;
  color: #38a169;
}

/* 列表设计 */
.list {
  background: white;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(27, 67, 50, 0.05);
}

.list-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f0f7f4;
  transition: background 0.3s ease;
}

.list-item:last-child {
  border-bottom: none;
}

.list-item:active {
  background: #f0f7f4;
}

.list-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 24rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.list-content {
  flex: 1;
}

.list-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #1e293b;
  margin-bottom: 8rpx;
}

.list-desc {
  font-size: 26rpx;
  color: #64748b;
}

.list-arrow {
  color: #94a3b8;
  font-size: 24rpx;
}

/* 表单设计 */
.form-group {
  margin-bottom: 32rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #374151;
  margin-bottom: 16rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border: 2rpx solid #f0f7f4;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #1e293b;
  background: white;
  transition: border-color 0.3s ease;
}

.form-input:focus {
  border-color: #2d6a4f;
  outline: none;
}

.form-input::placeholder {
  color: #94a3b8;
}

/* 评分设计 */
.rating {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.rating-star {
  color: #d69e2e;
  font-size: 28rpx;
}

.rating-star.empty {
  color: #fef2f2;
}

.rating-text {
  font-size: 26rpx;
  color: #64748b;
  margin-left: 8rpx;
}

/* 进度条设计 */
.progress {
  height: 12rpx;
  background: #f0f7f4;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-bar {
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

/* 加载状态 */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
  color: #64748b;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #fef2f2;
  border-top: 4rpx solid #2d6a4f;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  color: #94a3b8;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  line-height: 1.5;
  text-align: center;
}

/* 工具类 */
.text-center {
  text-align: center;
}

.text-left {
  text-align: left;
}

.text-right {
  text-align: right;
}

.font-bold {
  font-weight: 600;
}

.font-medium {
  font-weight: 500;
}

.font-normal {
  font-weight: 400;
}

.text-sm {
  font-size: 24rpx;
}

.text-base {
  font-size: 28rpx;
}

.text-lg {
  font-size: 32rpx;
}

.text-xl {
  font-size: 36rpx;
}

.text-2xl {
  font-size: 40rpx;
}

.mt-1 { margin-top: 8rpx; }
.mt-2 { margin-top: 16rpx; }
.mt-3 { margin-top: 24rpx; }
.mt-4 { margin-top: 32rpx; }
.mt-5 { margin-top: 40rpx; }

.mb-1 { margin-bottom: 8rpx; }
.mb-2 { margin-bottom: 16rpx; }
.mb-3 { margin-bottom: 24rpx; }
.mb-4 { margin-bottom: 32rpx; }
.mb-5 { margin-bottom: 40rpx; }

.ml-1 { margin-left: 8rpx; }
.ml-2 { margin-left: 16rpx; }
.ml-3 { margin-left: 24rpx; }

.mr-1 { margin-right: 8rpx; }
.mr-2 { margin-right: 16rpx; }
.mr-3 { margin-right: 24rpx; }

.p-1 { padding: 8rpx; }
.p-2 { padding: 16rpx; }
.p-3 { padding: 24rpx; }
.p-4 { padding: 32rpx; }

.flex {
  display: flex;
}

.flex-col {
  flex-direction: column;
}

.items-center {
  align-items: center;
}

.justify-center {
  justify-content: center;
}

.justify-between {
  justify-content: space-between;
}

.flex-1 {
  flex: 1;
}

.w-full {
  width: 100%;
}

.h-full {
  height: 100%;
}

/* 重庆特色元素 */
.chongqing-gradient {
  background: linear-gradient(135deg, #c41e2a 0%, #e53e3e 50%, #dd6b20 100%);
}

.hotpot-gradient {
  background: linear-gradient(135deg, #c41e2a 0%, #dd6b20 100%);
}

.mountain-gradient {
  background: linear-gradient(135deg, #38a169 0%, #48bb78 50%, #68d391 100%);
}

.river-gradient {
  background: linear-gradient(135deg, #3182ce 0%, #63b3ed 100%);
}

/* 响应式设计 */
@media (max-width: 750rpx) {
  .container {
    padding: 16rpx;
  }
  
  .card {
    padding: 24rpx;
  }
  
  .btn {
    padding: 16rpx 32rpx;
    font-size: 26rpx;
  }
}