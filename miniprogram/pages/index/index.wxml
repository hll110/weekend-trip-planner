<view class="page">
  <!-- 顶部 Hero -->
  <view class="hero">
    <view class="hero__top">
      <view class="hero__location" bindtap="changeLocation">
        <text class="hero__pin">📍</text>
        <view class="hero__loc-text">
          <text class="hero__loc-name">{{location.name}}</text>
          <text class="hero__loc-addr" wx:if="{{location.address}}">{{location.address}}</text>
        </view>
        <text class="hero__change">更换 ›</text>
      </view>
      <view class="hero__weather" wx:if="{{weather}}">
        <text class="hero__weather-icon">{{weather.icon}}</text>
        <text class="hero__weather-temp">{{weather.temp}}°</text>
      </view>
    </view>
    <view class="hero__brand">
      <view class="hero__title">周末出发 · 山城好去处</view>
      <view class="hero__subtitle" wx:if="{{weather}}">{{weather.travelTip}}</view>
    </view>
  </view>

  <!-- 筛选条件栏 -->
  <view class="filter-panel">
    <scroll-view class="filter-panel__row" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="filter-panel__inner">
        <view class="type-pill {{filters.audience === 'all' ? 'type-pill--on' : ''}}" bindtap="setAudienceFilter" data-audience="all">全部</view>
        <view class="type-pill type-pill--popular {{filters.audience === 'popular' ? 'type-pill--on' : ''}}" bindtap="setAudienceFilter" data-audience="popular">🏛️ 大众景点</view>
        <view class="type-pill type-pill--niche {{filters.audience === 'niche' ? 'type-pill--on' : ''}}" bindtap="setAudienceFilter" data-audience="niche">🌿 小众秘境</view>
      </view>
    </scroll-view>
    <view class="filter-panel__divider"></view>
    <scroll-view class="filter-panel__row" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="filter-panel__inner">
        <view class="type-pill {{filters.type === 'all' ? 'type-pill--on' : ''}}" bindtap="setTypeFilter" data-type="all">全部</view>
        <view class="type-pill type-pill--hiking {{filters.type === 'hiking' ? 'type-pill--on' : ''}}" bindtap="setTypeFilter" data-type="hiking">⛰️ 徒步爬山</view>
        <view class="type-pill {{filters.type === 'scenic' ? 'type-pill--on' : ''}}" bindtap="setTypeFilter" data-type="scenic">🏞️ 景区游玩</view>
        <view class="type-pill {{filters.type === 'food' ? 'type-pill--on' : ''}}" bindtap="setTypeFilter" data-type="food">🍲 美食路线</view>
      </view>
    </scroll-view>
  </view>

  <!-- 筛选摘要 -->
  <view class="filter-bar" wx:if="{{activeFilterLabels.length > 0}}">
    <scroll-view class="filter-bar__scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="filter-bar__inner">
        <text class="filter-tag" wx:for="{{activeFilterLabels}}" wx:key="*this">{{item}}</text>
      </view>
    </scroll-view>
    <text class="filter-bar__clear" bindtap="resetFilters">清除</text>
  </view>

  <!-- 路线列表 -->
  <view class="routes-header">
    <text class="routes-header__title">{{listTitle}}</text>
    <view class="routes-header__right">
      <text class="routes-header__count">{{filteredRoutes.length}} 条</text>
      <text class="routes-header__more" bindtap="openFilter">筛选 ›</text>
    </view>
  </view>

  <view wx:if="{{filteredRoutes.length > 0}}" class="routes-list">
    <view
      class="route-card"
      wx:for="{{filteredRoutes}}"
      wx:key="id"
      bindtap="goToRouteDetail"
      data-id="{{item.id}}"
      hover-class="route-card--hover"
    >
      <view class="route-card__img-wrap">
        <swiper
          class="route-card__swiper"
          indicator-dots="{{item.imageCount > 1}}"
          indicator-color="rgba(255,255,255,0.4)"
          indicator-active-color="#ffffff"
          autoplay="{{item.imageCount > 1}}"
          interval="4000"
          circular
          catchtap="preventTap"
        >
          <swiper-item wx:for="{{item.images}}" wx:for-item="img" wx:key="*this">
            <image
              src="{{img}}"
              mode="aspectFill"
              class="route-card__img"
              lazy-load="{{true}}"
              data-id="{{item.id}}"
              data-index="{{index}}"
              binderror="onImageError"
            />
          </swiper-item>
        </swiper>
        <view class="route-card__badges">
          <view class="route-card__badges-left">
            <text class="route-card__audience route-card__audience--{{item.audience}}">{{item.audienceLabel}}</text>
            <text class="route-card__type route-card__type--{{item.type}}">
              {{item.type === 'hiking' ? '徒步' : item.type === 'food' ? '美食' : '景区'}}
            </text>
          </view>
          <text class="route-card__duration">{{item.duration === '1day' ? '1日游' : '2日游'}}</text>
        </view>
        <view class="route-card__img-count" wx:if="{{item.imageCount > 1}}">{{item.imageCount}} 图</view>
      </view>

      <view class="route-card__body">
        <view class="route-card__head">
          <text class="route-card__name">{{item.name}}</text>
          <view class="route-card__rating">
            <text class="route-card__star">★</text>
            <text class="route-card__score">{{item.rating}}</text>
          </view>
        </view>
        <text class="route-card__desc">{{item.description}}</text>
        <view class="route-card__meta">
          <text class="route-card__district" wx:if="{{item.districtName}}">📍 {{item.districtName}}</text>
          <text class="route-card__distance">{{item.distance}}</text>
        </view>
        <view class="route-card__tags" wx:if="{{item.highlights && item.highlights.length}}">
          <text class="route-card__tag" wx:for="{{item.highlights}}" wx:for-item="tag" wx:key="*this" wx:if="{{index < 3}}">{{tag}}</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:else class="empty">
    <text class="empty__icon">🥾</text>
    <text class="empty__text">暂无符合条件的路线</text>
    <text class="empty__hint">试试调整筛选条件，或浏览全部路线</text>
    <button class="empty__btn" bindtap="resetFilters">查看全部路线</button>
  </view>
</view>
