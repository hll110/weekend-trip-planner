.page-discover { padding-bottom: 32rpx; }
.weather-card { background: linear-gradient(135deg, #c41e2a 0%, #e53e3e 100%); color: #fff; border: none; }
.weather-main { display: flex; align-items: center; }
.weather-icon { font-size: 64rpx; margin-right: 24rpx; }
.weather-city { font-size: 32rpx; font-weight: 600; }
.weather-temp { font-size: 28rpx; margin-top: 8rpx; opacity: 0.95; }
.weather-sub { font-size: 24rpx; margin-top: 8rpx; opacity: 0.85; }
.weather-tip { margin-top: 24rpx; font-size: 26rpx; background: rgba(255,255,255,0.15); padding: 16rpx; border-radius: 12rpx; }
.dialect-phrase { font-size: 40rpx; font-weight: bold; color: #c41e2a; margin: 16rpx 0; }
.dialect-meaning, .dialect-scene { font-size: 26rpx; color: #64748b; }
.menu-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.menu-item { text-align: center; padding: 28rpx 12rpx; }
.menu-icon { display: block; font-size: 48rpx; margin-bottom: 12rpx; }
.menu-name { font-size: 26rpx; color: #1e293b; }
.section-title { font-size: 30rpx; font-weight: 600; margin-bottom: 20rpx; color: #1e293b; }
.festival-item { padding: 20rpx 0; border-bottom: 1rpx solid #f1f5f9; }
.festival-item:last-child { border-bottom: none; }
.festival-name { font-size: 28rpx; font-weight: 600; color: #c41e2a; }
.festival-meta { font-size: 24rpx; color: #94a3b8; margin: 8rpx 0; }
.festival-desc { font-size: 26rpx; color: #64748b; }
.chip-row { display: flex; flex-wrap: wrap; gap: 16rpx; }
.chip { padding: 12rpx 28rpx; background: #fef2f2; color: #c41e2a; border-radius: 32rpx; font-size: 26rpx; }
.chip.small { font-size: 24rpx; padding: 10rpx 20rpx; }
.chip-row.wrap { max-height: 320rpx; overflow-y: auto; }
