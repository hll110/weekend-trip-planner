<view class="page">
  <view wx:if="{{route}}">
    <view class="route-header">
      <swiper
        class="route-gallery"
        indicator-dots="{{route.imageCount > 1}}"
        indicator-color="rgba(255,255,255,0.45)"
        indicator-active-color="#ffffff"
        autoplay="{{route.imageCount > 1}}"
        interval="4500"
        circular
        bindchange="onGalleryChange"
      >
        <swiper-item wx:for="{{route.images}}" wx:for-item="img" wx:key="*this">
          <image
            src="{{img}}"
            mode="aspectFill"
            class="route-bg"
            data-index="{{index}}"
            binderror="onGalleryImageError"
          />
        </swiper-item>
      </swiper>
      <view class="gallery-index" wx:if="{{route.imageCount > 1}}">{{galleryIndex + 1}} / {{route.imageCount}}</view>
      <view class="route-overlay">
        <view class="route-title">{{route.name}}</view>
        <view class="route-meta">
          <view class="route-rating">
            <text class="rating-star">★</text>
            <text class="rating-value">{{route.rating}}</text>
            <text class="rating-count">({{route.reviews}}条评价)</text>
          </view>
          <view class="route-badges">
            <view class="route-audience-badge route-audience-badge--{{route.audience}}">{{route.audienceLabel}}</view>
            <view class="route-type-badge {{route.type}}">
              {{route.type === 'food' ? '美食' : route.type === 'hiking' ? '徒步' : '景区'}}
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="route-info card">
      <view class="info-header">
        <view class="info-title">路线概览</view>
        <view class="info-duration">
          <icon type="time" size="14" color="#2d6a4f"/>
          <text>{{route.duration === '1day' ? '1日游' : '2日游'}}</text>
        </view>
      </view>

      <view class="info-desc">{{route.description}}</view>
      <view class="info-district" wx:if="{{districtName}}">📍 {{districtName}}</view>

      <view class="info-stats">
        <view class="stat-item">
          <view class="stat-value">{{route.distance}}</view>
          <view class="stat-label">总距离</view>
        </view>
        <view class="stat-item">
          <view class="stat-value">{{route.duration === '1day' ? '1天' : '2天'}}</view>
          <view class="stat-label">建议时长</view>
        </view>
        <view class="stat-item">
          <view class="stat-value">{{route.spots.length}}</view>
          <view class="stat-label">途经景点</view>
        </view>
      </view>

      <view class="route-tags">
        <view class="tag tag-primary" wx:for="{{route.tags}}" wx:key="*this">{{item}}</view>
      </view>
    </view>

    <view class="spots-section card">
      <view class="section-title">
        <icon type="location" size="16" color="#2d6a4f"/>
        <text>途经景点</text>
        <text class="section-hint">点击可导航</text>
      </view>

      <view class="spots-list">
        <view class="spot-item" wx:for="{{route.spots}}" wx:key="name" bindtap="navigateToSpot" data-index="{{index}}" hover-class="spot-item--hover">
          <view class="spot-index">{{index + 1}}</view>
          <view class="spot-content">
            <view class="spot-name">{{item.name}}</view>
            <view class="spot-details">
              <view class="spot-time">
                <icon type="time" size="12" color="#64748b"/>
                <text>{{item.time}}</text>
              </view>
              <view class="spot-ticket">
                <icon type="money" size="12" color="#64748b"/>
                <text>{{item.ticket}}</text>
              </view>
            </view>
          </view>
          <view class="spot-nav">
            <text class="spot-nav__text">导航</text>
            <icon type="right" size="14" color="#2d6a4f"/>
          </view>
        </view>
      </view>
    </view>

    <view class="food-section card" wx:if="{{route.food && route.food.length}}">
      <view class="section-title">
        <icon type="restaurant" size="16" color="#dd6b20"/>
        <text>沿途美食</text>
      </view>

      <view class="food-highlights">
        <view class="food-highlight" wx:for="{{route.food}}" wx:key="*this">
          <text class="food-icon">🍽️</text>
          <text class="food-name">{{item}}</text>
        </view>
      </view>

      <view class="food-spots-list" wx:if="{{route.foodSpots && route.foodSpots.length}}">
        <view class="food-spot-item" wx:for="{{route.foodSpots}}" wx:key="name">
          <view class="food-spot-header">
            <view class="food-spot-name">{{item.name}}</view>
            <view class="food-spot-type">{{item.type}}</view>
          </view>
          <view class="food-spot-price">{{item.price}}</view>
        </view>
      </view>
    </view>

    <view class="schedule-section card">
      <view class="section-title">
        <icon type="calendar" size="16" color="#2d6a4f"/>
        <text>行程安排</text>
      </view>

      <view class="schedule-timeline">
        <view class="timeline-item" wx:for="{{route.spots}}" wx:key="name">
          <view class="timeline-dot"></view>
          <view class="timeline-content">
            <view class="timeline-time">第{{index + 1}}站</view>
            <view class="timeline-title">{{item.name}}</view>
            <view class="timeline-desc">{{item.time}} · {{item.ticket}}</view>
          </view>
        </view>
      </view>
    </view>

    <view class="bottom-spacer"></view>
  </view>

  <view wx:else class="loading">
    <view class="loading-spinner"></view>
    <view class="loading-text">加载中...</view>
  </view>

  <view class="action-bar" wx:if="{{route}}">
    <button class="action-bar__btn action-bar__btn--share" bindtap="shareRoute">
      <text>分享</text>
    </button>
    <button class="action-bar__btn action-bar__btn--nav" bindtap="startNavigation">
      <icon type="location" size="18" color="#fff"/>
      <text>开始导航</text>
    </button>
  </view>
</view>
