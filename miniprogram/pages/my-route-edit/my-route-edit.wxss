.field { margin-bottom: 28rpx; }
.label { display: block; font-size: 26rpx; color: #64748b; margin-bottom: 12rpx; }
input, textarea { width: 100%; font-size: 28rpx; padding: 16rpx; background: #f8fafc; border-radius: 12rpx; box-sizing: border-box; }
textarea { min-height: 160rpx; }
.chips, .chip-scroll { display: flex; flex-wrap: wrap; gap: 16rpx; }
.chip { padding: 12rpx 24rpx; background: #f1f5f9; border-radius: 24rpx; font-size: 26rpx; }
.chip.on { background: #c41e2a; color: #fff; }
.chip.small { font-size: 24rpx; padding: 8rpx 16rpx; }
.picker-val { font-size: 28rpx; color: #1e293b; margin-bottom: 12rpx; }
