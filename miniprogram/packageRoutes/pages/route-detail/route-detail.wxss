.page {
  min-height: 100vh;
  background: #f0f7f4;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.info-district {
  font-size: 26rpx;
  color: #2d6a4f;
  margin: 12rpx 0 16rpx;
}

/* 路线头部 */
.route-header {
  position: relative;
  height: 440rpx;
  margin: 0;
}

.route-gallery,
.route-bg {
  width: 100%;
  height: 440rpx;
  display: block;
}

.gallery-index {
  position: absolute;
  right: 24rpx;
  bottom: 130rpx;
  z-index: 3;
  padding: 8rpx 18rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  font-size: 24rpx;
  border-radius: 24rpx;
}

.route-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.75));
  padding: 48rpx 28rpx 28rpx;
}

.route-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 16rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}

.route-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.route-badges {
  display: flex;
  gap: 10rpx;
  flex-shrink: 0;
}

.route-rating {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.rating-star { font-size: 28rpx; color: #fbbf24; }
.rating-value { font-size: 32rpx; font-weight: 600; color: #fbbf24; }
.rating-count { font-size: 24rpx; color: rgba(255, 255, 255, 0.8); }

.route-type-badge {
  padding: 8rpx 18rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #fff;
  font-weight: 500;
}

.route-type-badge.food { background: rgba(196, 30, 42, 0.85); }
.route-type-badge.hiking { background: rgba(27, 67, 50, 0.85); }
.route-type-badge.scenic { background: rgba(221, 107, 32, 0.85); }

.route-audience-badge {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #fff;
  font-weight: 600;
}

.route-audience-badge--popular { background: rgba(221, 107, 32, 0.9); }
.route-audience-badge--niche { background: rgba(27, 67, 50, 0.9); }

/* 卡片 */
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin: 20rpx 24rpx 0;
  box-shadow: 0 2rpx 12rpx rgba(27, 67, 50, 0.06);
}

.info-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.info-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1e293b;
}

.info-duration {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #2d6a4f;
  font-size: 26rpx;
  font-weight: 500;
}

.info-desc {
  font-size: 28rpx;
  color: #64748b;
  line-height: 1.65;
  margin-bottom: 16rpx;
}

.info-stats {
  display: flex;
  justify-content: space-around;
  background: #f0f7f4;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.stat-item { text-align: center; }
.stat-value { font-size: 36rpx; font-weight: 600; color: #2d6a4f; margin-bottom: 8rpx; }
.stat-label { font-size: 24rpx; color: #64748b; }

.route-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag-primary {
  padding: 8rpx 20rpx;
  background: #f0f7f4;
  color: #2d6a4f;
  border-radius: 16rpx;
  font-size: 24rpx;
}

/* 景点 */
.section-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #1e293b;
  margin-bottom: 24rpx;
}

.section-hint {
  margin-left: auto;
  font-size: 22rpx;
  color: #94a3b8;
  font-weight: 400;
}

.spots-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.spot-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #f8fafc;
  border-radius: 16rpx;
}

.spot-item--hover {
  background: #e8f5e9;
}

.spot-index {
  width: 48rpx;
  height: 48rpx;
  background: linear-gradient(135deg, #1b4332, #2d6a4f);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.spot-content { flex: 1; min-width: 0; }
.spot-name { font-size: 30rpx; font-weight: 500; color: #1e293b; margin-bottom: 8rpx; }
.spot-details { display: flex; gap: 24rpx; }
.spot-time, .spot-ticket {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #64748b;
}

.spot-nav {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.spot-nav__text {
  font-size: 24rpx;
  color: #2d6a4f;
  font-weight: 500;
}

/* 美食 */
.food-highlights {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.food-highlight {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  background: #fffbeb;
  border-radius: 20rpx;
}

.food-name { font-size: 26rpx; color: #dd6b20; font-weight: 500; }

.food-spots-list { display: flex; flex-direction: column; gap: 16rpx; }

.food-spot-item {
  padding: 20rpx;
  background: #f8fafc;
  border-radius: 16rpx;
}

.food-spot-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.food-spot-name { font-size: 28rpx; font-weight: 500; color: #1e293b; }
.food-spot-type {
  font-size: 24rpx;
  color: #2d6a4f;
  background: #f0f7f4;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.food-spot-price { font-size: 26rpx; color: #64748b; }

/* 行程 */
.schedule-timeline {
  position: relative;
  padding-left: 40rpx;
}

.schedule-timeline::before {
  content: '';
  position: absolute;
  left: 16rpx;
  top: 0;
  bottom: 0;
  width: 2rpx;
  background: #d8f3dc;
}

.timeline-item {
  position: relative;
  margin-bottom: 28rpx;
}

.timeline-item:last-child { margin-bottom: 0; }

.timeline-dot {
  position: absolute;
  left: -32rpx;
  top: 8rpx;
  width: 16rpx;
  height: 16rpx;
  background: #2d6a4f;
  border-radius: 50%;
  border: 4rpx solid #fff;
  box-shadow: 0 0 0 2rpx #2d6a4f;
}

.timeline-content {
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 20rpx;
}

.timeline-time { font-size: 24rpx; color: #2d6a4f; font-weight: 500; margin-bottom: 8rpx; }
.timeline-title { font-size: 30rpx; font-weight: 500; color: #1e293b; margin-bottom: 8rpx; }
.timeline-desc { font-size: 26rpx; color: #64748b; }

.bottom-spacer { height: 40rpx; }

/* 底部操作栏 */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.08);
  z-index: 100;
}

.action-bar__btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  margin: 0;
  padding: 0;
}

.action-bar__btn::after { border: none; }

.action-bar__btn--share {
  flex: 0 0 180rpx;
  background: #f0f7f4;
  color: #2d6a4f;
}

.action-bar__btn--nav {
  flex: 1;
  background: linear-gradient(135deg, #1b4332, #2d6a4f);
  color: #fff;
}

/* 加载 */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #f0f7f4;
  border-top: 4rpx solid #2d6a4f;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text { font-size: 28rpx; color: #64748b; }
