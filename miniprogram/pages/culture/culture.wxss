.tabs { white-space: nowrap; margin-bottom: 24rpx; }
.tab { display: inline-block; padding: 16rpx 28rpx; margin-right: 16rpx; background: #fff; border-radius: 32rpx; font-size: 26rpx; color: #64748b; }
.tab.active { background: #c41e2a; color: #fff; }
.article-title { font-size: 36rpx; font-weight: 600; color: #c41e2a; margin-bottom: 16rpx; }
.article-summary { font-size: 28rpx; color: #475569; margin-bottom: 24rpx; line-height: 1.6; }
.article-content { font-size: 28rpx; color: #64748b; line-height: 1.8; }
