<view class="filter-page">
  <scroll-view class="filter-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="filter-inner">
      <view class="filter-header">
        <view class="filter-title">路线筛选</view>
        <view class="filter-subtitle">已匹配 <text class="count-num">{{filteredCount}}</text> 条路线</view>
      </view>

      <view class="filter-section card">
        <view class="section-title">景点类型</view>
        <view class="type-grid type-grid--2">
          <view class="type-option {{filters.audience === 'all' ? 'active' : ''}}" bindtap="setAudience" data-audience="all">
            <text class="type-icon">🗺️</text><text class="type-name">全部</text>
          </view>
          <view class="type-option type-option--popular {{filters.audience === 'popular' ? 'active' : ''}}" bindtap="setAudience" data-audience="popular">
            <text class="type-icon">🏛️</text><text class="type-name">大众景点</text>
          </view>
          <view class="type-option type-option--niche {{filters.audience === 'niche' ? 'active' : ''}}" bindtap="setAudience" data-audience="niche">
            <text class="type-icon">🌿</text><text class="type-name">小众秘境</text>
          </view>
        </view>
      </view>

      <view class="filter-section card">
        <view class="section-title">路线类型</view>
        <view class="type-grid">
          <view class="type-option {{filters.type === 'all' ? 'active' : ''}}" bindtap="setType" data-type="all">
            <text class="type-icon">🗺️</text><text class="type-name">全部</text>
          </view>
          <view class="type-option {{filters.type === 'hiking' ? 'active' : ''}}" bindtap="setType" data-type="hiking">
            <text class="type-icon">⛰️</text><text class="type-name">徒步</text>
          </view>
          <view class="type-option {{filters.type === 'scenic' ? 'active' : ''}}" bindtap="setType" data-type="scenic">
            <text class="type-icon">🏞️</text><text class="type-name">景区</text>
          </view>
          <view class="type-option {{filters.type === 'food' ? 'active' : ''}}" bindtap="setType" data-type="food">
            <text class="type-icon">🍲</text><text class="type-name">美食</text>
          </view>
        </view>
      </view>

      <view class="filter-section card">
        <view class="section-title">行程时长</view>
        <view class="chip-row">
          <view class="chip {{filters.duration === 'all' ? 'active' : ''}}" bindtap="setDuration" data-duration="all">全部</view>
          <view class="chip {{filters.duration === '1day' ? 'active' : ''}}" bindtap="setDuration" data-duration="1day">1日游</view>
          <view class="chip {{filters.duration === '2day' ? 'active' : ''}}" bindtap="setDuration" data-duration="2day">2日游</view>
        </view>
      </view>

      <view class="filter-section card">
        <view class="section-title">所在区县</view>
        <scroll-view class="district-scroll" scroll-x enhanced show-scrollbar="{{false}}">
          <view class="chip inline {{filters.district === item.id ? 'active' : ''}}" wx:for="{{districts}}" wx:key="id"
            bindtap="setDistrict" data-id="{{item.id}}">{{item.name}}</view>
        </scroll-view>
      </view>

      <view class="filter-section card">
        <view class="section-title">出行季节</view>
        <view class="chip-row">
          <view class="chip {{filters.season === item.id ? 'active' : ''}}" wx:for="{{seasons}}" wx:key="id"
            bindtap="setSeason" data-id="{{item.id}}">{{item.icon}} {{item.name}}</view>
        </view>
      </view>

      <view class="filter-section card">
        <view class="section-title">其他条件</view>
        <view class="switch-row">
          <text>仅显示评分 ≥ 4.5</text>
          <switch checked="{{filters.highRating}}" bindchange="toggleHighRating" color="#2d6a4f"/>
        </view>
      </view>

      <view class="filter-preview card" wx:if="{{previewRoutes.length > 0}}">
        <view class="section-title">预览</view>
        <view class="preview-route" wx:for="{{previewRoutes}}" wx:key="id">
          <text class="preview-name">{{item.name}}</text>
          <text class="preview-type">{{item.audienceLabel}} · {{item.type === 'food' ? '美食' : item.type === 'hiking' ? '徒步' : '景区'}}</text>
        </view>
      </view>
    </view>
  </scroll-view>

  <view class="filter-footer">
    <button class="btn btn-outline" bindtap="resetFilters">重置</button>
    <button class="btn btn-primary" bindtap="applyFilters">查看 {{filteredCount}} 条路线</button>
  </view>
</view>
