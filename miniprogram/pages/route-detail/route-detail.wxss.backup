/* pages/route-detail/route-detail.wxss */

/* 路线头部 */
.route-header {
  position: relative;
  height: 400rpx;
  margin: -24rpx -24rpx 24rpx;
}

.route-bg {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.route-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
  padding: 40rpx 24rpx 24rpx;
}

.route-title {
  font-size: 40rpx;
  font-weight: 600;
  color: white;
  margin-bottom: 16rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
}

.route-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.route-rating {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.rating-star {
  font-size: 28rpx;
}

.rating-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #fbbf24;
}

.rating-count {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.route-type-badge {
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: white;
  font-weight: 500;
}

.route-type-badge.food {
  background: linear-gradient(135deg, #f59e0b 0%, #f97316 100%);
}

.route-type-badge.hiking {
  background: linear-gradient(135deg, #10b981 0%, #14b8a6 100%);
}

.route-type-badge.scenic {
  background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
}

/* 路线信息 */
.route-info {
  margin-bottom: 24rpx;
}

.info-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.info-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1e293b;
}

.info-duration {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #4f46e5;
  font-size: 26rpx;
  font-weight: 500;
}

.info-desc {
  font-size: 28rpx;
  color: #64748b;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.info-stats {
  display: flex;
  justify-content: space-around;
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.stat-item {
  text-align: center;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 600;
  color: #4f46e5;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #64748b;
}

.route-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

/* 景点部分 */
.spots-section {
  margin-bottom: 24rpx;
}

.section-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #1e293b;
  margin-bottom: 24rpx;
}

.spots-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.spot-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #f8fafc;
  border-radius: 16rpx;
  transition: all 0.3s ease;
}

.spot-item:active {
  background: #e2e8f0;
}

.spot-index {
  width: 48rpx;
  height: 48rpx;
  background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 24rpx;
  font-weight: 600;
  margin-right: 20rpx;
}

.spot-content {
  flex: 1;
}

.spot-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #1e293b;
  margin-bottom: 8rpx;
}

.spot-details {
  display: flex;
  gap: 24rpx;
}

.spot-time, .spot-ticket {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #64748b;
}

.spot-arrow {
  color: #94a3b8;
}

/* 美食部分 */
.food-section {
  margin-bottom: 24rpx;
}

.food-highlights {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.food-highlight {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  background: #fffbeb;
  border-radius: 20rpx;
}

.food-icon {
  font-size: 24rpx;
}

.food-name {
  font-size: 26rpx;
  color: #f59e0b;
  font-weight: 500;
}

.food-spots-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.food-spot-item {
  padding: 20rpx;
  background: #f8fafc;
  border-radius: 16rpx;
}

.food-spot-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.food-spot-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #1e293b;
}

.food-spot-type {
  font-size: 24rpx;
  color: #4f46e5;
  background: #eef2ff;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.food-spot-price {
  font-size: 26rpx;
  color: #64748b;
}

/* 行程安排 */
.schedule-section {
  margin-bottom: 24rpx;
}

.schedule-timeline {
  position: relative;
  padding-left: 40rpx;
}

.schedule-timeline::before {
  content: '';
  position: absolute;
  left: 16rpx;
  top: 0;
  bottom: 0;
  width: 2rpx;
  background: #e2e8f0;
}

.timeline-item {
  position: relative;
  margin-bottom: 32rpx;
}

.timeline-item:last-child {
  margin-bottom: 0;
}

.timeline-dot {
  position: absolute;
  left: -32rpx;
  top: 8rpx;
  width: 16rpx;
  height: 16rpx;
  background: #4f46e5;
  border-radius: 50%;
  border: 4rpx solid white;
  box-shadow: 0 0 0 2rpx #4f46e5;
}

.timeline-content {
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 20rpx;
}

.timeline-time {
  font-size: 24rpx;
  color: #4f46e5;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.timeline-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #1e293b;
  margin-bottom: 8rpx;
}

.timeline-desc {
  font-size: 26rpx;
  color: #64748b;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  gap: 16rpx;
  margin-top: 40rpx;
  padding: 0 24rpx 40rpx;
}

.action-buttons .btn {
  flex: 1;
  height: 96rpx;
}

/* 加载状态 */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
}

.loading-text {
  font-size: 28rpx;
  color: #64748b;
  margin-top: 20rpx;
}

/* 响应式设计 */
@media (max-width: 750rpx) {
  .route-header {
    height: 300rpx;
  }
  
  .route-title {
    font-size: 36rpx;
  }
  
  .info-stats {
    padding: 20rpx;
  }
  
  .stat-value {
    font-size: 32rpx;
  }
  
  .action-buttons {
    flex-direction: column;
  }
}