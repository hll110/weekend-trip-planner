.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(12px);
  box-shadow: 0 -2rpx 24rpx rgba(27, 67, 50, 0.08);
  border-top: 1rpx solid rgba(45, 106, 79, 0.08);
}

.tab-bar__inner {
  display: flex;
  align-items: stretch;
  height: 110rpx;
  padding: 8rpx 16rpx 0;
}

.tab-bar__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  padding: 4rpx 0;
  transition: transform 0.2s ease;
}

.tab-bar__item--active {
  transform: translateY(-2rpx);
}

.tab-bar__icon-wrap {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  background: transparent;
  transition: background 0.2s ease;
}

.tab-bar__item--active .tab-bar__icon-wrap {
  background: linear-gradient(145deg, #f0f7f4 0%, #d8f3dc 100%);
  box-shadow: 0 4rpx 16rpx rgba(45, 106, 79, 0.15);
}

.tab-bar__icon {
  font-size: 40rpx;
  line-height: 1;
}

.tab-bar__text {
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 4rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
}

.tab-bar__item--active .tab-bar__text {
  color: #2d6a4f;
  font-weight: 600;
}

.tab-bar__dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #1b4332 0%, #2d6a4f 100%);
  margin-top: 6rpx;
}

.tab-bar__safe {
  height: env(safe-area-inset-bottom);
  background: rgba(255, 255, 255, 0.96);
}
