<!--pages/index/index.wxml-->
<view class="container">
  <!-- 位置信息卡片 -->
  <view class="location-card card">
    <view class="location-header">
      <view class="location-icon">📍</view>
      <view class="location-info">
        <view class="location-title">当前位置</view>
        <view class="location-name">{{location.name}}</view>
        <view class="location-address">{{location.address}}</view>
      </view>
      <view class="location-change" bindtap="changeLocation">
        <text>更换</text>
        <icon type="right" size="14" color="#c41e2a"/>
      </view>
    </view>
    
    <view class="brand-slogan">
      <text class="slogan-text">渝趣周边游 · 发现山城之美</text>
    </view>
  </view>

  <view class="weather-card card" wx:if="{{weather}}" bindtap="goDiscover">
    <view class="weather-row">
      <text class="weather-emoji">{{weather.icon}}</text>
      <view class="weather-body">
        <view class="weather-line">重庆 {{weather.temp}}°C · {{weather.description}}</view>
        <view class="weather-tip">{{weather.travelTip}}</view>
      </view>
      <text class="weather-more">发现 ›</text>
    </view>
    <view class="dialect-bar" wx:if="{{dialect}}">🗣️ {{dialect.phrase}} — {{dialect.meaning}}</view>
  </view>
  
  <view class="filter-panel card">
    <view class="filter-panel__head">
      <text class="filter-panel__title">筛选条件</text>
      <text class="filter-panel__link" bindtap="openFilter">更多筛选</text>
    </view>

    <view class="filter-panel__summary" wx:if="{{activeFilterLabels.length > 0}}">
      <view class="filter-panel__tags">
        <text class="filter-chip filter-chip--on" wx:for="{{activeFilterLabels}}" wx:key="*this">{{item}}</text>
      </view>
      <text class="filter-panel__clear" bindtap="resetFilters">清除</text>
    </view>

    <view class="filter-group">
      <text class="filter-group__label">路线类型</text>
      <view class="filter-group__chips">
        <view class="filter-chip {{filters.type === 'all' ? 'filter-chip--on' : ''}}" bindtap="setTypeFilter" data-type="all">全部</view>
        <view class="filter-chip {{filters.type === 'food' ? 'filter-chip--on' : ''}}" bindtap="setTypeFilter" data-type="food">🍲 美食</view>
        <view class="filter-chip {{filters.type === 'hiking' ? 'filter-chip--on' : ''}}" bindtap="setTypeFilter" data-type="hiking">⛰️ 徒步</view>
        <view class="filter-chip {{filters.type === 'scenic' ? 'filter-chip--on' : ''}}" bindtap="setTypeFilter" data-type="scenic">🏞️ 景区</view>
      </view>
    </view>

    <view class="filter-group">
      <text class="filter-group__label">行程时长</text>
      <view class="filter-group__chips">
        <view class="filter-chip {{filters.duration === 'all' ? 'filter-chip--on' : ''}}" bindtap="setDurationFilter" data-duration="all">不限</view>
        <view class="filter-chip {{filters.duration === '1day' ? 'filter-chip--on' : ''}}" bindtap="setDurationFilter" data-duration="1day">1 日游</view>
        <view class="filter-chip {{filters.duration === '2day' ? 'filter-chip--on' : ''}}" bindtap="setDurationFilter" data-duration="2day">2 日游</view>
      </view>
    </view>

    <view class="filter-group filter-group--last">
      <view class="filter-group__row">
        <text class="filter-group__label">所在区县</text>
        <text class="filter-group__more" bindtap="openFilter">全部区县 ›</text>
      </view>
      <scroll-view class="filter-scroll" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="filter-scroll__inner">
          <view class="filter-chip {{filters.district === 'all' ? 'filter-chip--on' : ''}}" bindtap="setDistrictFilter" data-district="all">不限</view>
          <view class="filter-chip {{filters.district === item.id ? 'filter-chip--on' : ''}}" wx:for="{{districtOptions}}" wx:key="id"
            bindtap="setDistrictFilter" data-district="{{item.id}}">{{item.name}}</view>
        </view>
      </scroll-view>
    </view>

    <view class="filter-group filter-group--last">
      <text class="filter-group__label">出行季节</text>
      <view class="filter-group__chips">
        <view class="filter-chip {{filters.season === 'all' ? 'filter-chip--on' : ''}}" bindtap="setSeasonFilter" data-season="all">不限</view>
        <view class="filter-chip {{filters.season === 'spring' ? 'filter-chip--on' : ''}}" bindtap="setSeasonFilter" data-season="spring">🌸 春</view>
        <view class="filter-chip {{filters.season === 'summer' ? 'filter-chip--on' : ''}}" bindtap="setSeasonFilter" data-season="summer">☀️ 夏</view>
        <view class="filter-chip {{filters.season === 'autumn' ? 'filter-chip--on' : ''}}" bindtap="setSeasonFilter" data-season="autumn">🍂 秋</view>
        <view class="filter-chip {{filters.season === 'winter' ? 'filter-chip--on' : ''}}" bindtap="setSeasonFilter" data-season="winter">❄️ 冬</view>
      </view>
    </view>
  </view>
  
  <!-- 推荐路线 -->
  <view class="routes-section">
    <view class="section-header">
      <view class="section-title">🔥 热门路线</view>
      <view class="section-count">共{{filteredRoutes.length}}条路线</view>
    </view>
    
    <view wx:if="{{filteredRoutes.length > 0}}">
      <view class="route-card card" wx:for="{{filteredRoutes}}" wx:key="id">
        <view class="route-image">
          <swiper
            class="route-swiper"
            indicator-dots="{{item.imageCount > 1}}"
            indicator-color="rgba(255,255,255,0.5)"
            indicator-active-color="#ffffff"
            autoplay="{{item.imageCount > 1}}"
            interval="4000"
            circular
            catchtap="preventTap"
          >
            <swiper-item wx:for="{{item.images}}" wx:for-item="img" wx:key="*this">
              <image
                src="{{img}}"
                mode="aspectFill"
                class="route-img"
                lazy-load="{{true}}"
                data-id="{{item.id}}"
                data-index="{{index}}"
                binderror="onImageError"
              />
            </swiper-item>
          </swiper>
          <view class="route-img-count" wx:if="{{item.imageCount > 1}}">{{item.imageCount}}图</view>
          <view class="route-type-badge {{item.type}}">
            {{item.type === 'food' ? '美食' : item.type === 'hiking' ? '徒步' : '景区'}}
          </view>
          <view class="route-duration-badge">
            {{item.duration === '1day' ? '1日游' : '2日游'}}
          </view>
        </view>
        
        <view class="route-content" bindtap="goToRouteDetail" data-id="{{item.id}}">
          <view class="route-header">
            <view class="route-name">{{item.name}}</view>
            <view class="route-rating">
              <text class="rating-star">⭐</text>
              <text class="rating-text">{{item.rating}}</text>
              <text class="review-count">({{item.reviews}}条评价)</text>
            </view>
          </view>
          
          <view class="route-desc">{{item.description}}</view>
          
          <view class="route-district" wx:if="{{item.districtName}}">📍 {{item.districtName}}</view>
          <view class="route-meta">
            <view class="meta-item">
              <icon type="location" size="14" color="#64748b"/>
              <text>{{item.distance}}</text>
            </view>
            <view class="meta-item">
              <icon type="time" size="14" color="#64748b"/>
              <text>{{item.duration === '1day' ? '1天' : '2天'}}</text>
            </view>
          </view>
          
          <view class="route-highlights" wx:if="{{item.highlights && item.highlights.length}}">
            <view class="highlight-tag" wx:for="{{item.highlights}}" wx:for-item="highlight" wx:key="*this" wx:if="{{index < 3}}">
              {{highlight}}
            </view>
          </view>
        </view>
      </view>
    </view>
    
    <view wx:else class="empty-state">
      <view class="empty-icon">🗺️</view>
      <view class="empty-text">暂无符合条件的路线</view>
      <button class="btn btn-primary mt-4" bindtap="resetFilters">重置筛选条件</button>
    </view>
  </view>
</view>