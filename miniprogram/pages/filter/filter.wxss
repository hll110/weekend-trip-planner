.filter-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f0f7f4;
  padding-bottom: calc(110rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.filter-scroll {
  flex: 1;
  height: 0;
}

.filter-inner {
  padding: 24rpx;
  padding-bottom: 220rpx;
}

.filter-header {
  margin-bottom: 24rpx;
}

.filter-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #1e293b;
}

.filter-subtitle {
  font-size: 28rpx;
  color: #64748b;
  margin-top: 8rpx;
}

.count-num {
  color: #2d6a4f;
  font-weight: 600;
}

.filter-section {
  margin-bottom: 20rpx;
}

.type-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.type-option {
  text-align: center;
  padding: 20rpx 8rpx;
  background: #f8fafc;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
}

.type-option.active {
  background: #f0f7f4;
  border-color: #2d6a4f;
}

.type-icon {
  display: block;
  font-size: 36rpx;
}

.type-name {
  font-size: 24rpx;
  color: #475569;
  margin-top: 8rpx;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip-row.wrap .chip {
  max-width: 100%;
}

.chip {
  padding: 14rpx 28rpx;
  background: #f1f5f9;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #64748b;
}

.chip.inline {
  display: inline-block;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.chip.active {
  background: #2d6a4f;
  color: #fff;
}

.district-scroll {
  white-space: nowrap;
  width: 100%;
}

.switch-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  color: #475569;
}

.preview-route {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.preview-name {
  font-size: 28rpx;
  color: #1e293b;
  flex: 1;
}

.preview-type {
  font-size: 24rpx;
  color: #2d6a4f;
}

.filter-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(110rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 20rpx;
  padding: 20rpx 24rpx;
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.filter-footer .btn {
  flex: 1;
  margin: 0;
}
