.page {
  min-height: 100vh;
  padding-bottom: calc(130rpx + env(safe-area-inset-bottom));
  background: #f0f7f4;
}

/* Hero */
.hero {
  background: linear-gradient(160deg, #1b4332 0%, #2d6a4f 55%, #40916c 100%);
  padding: 24rpx 28rpx 32rpx;
  color: #fff;
}

.hero__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.hero__location {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.hero__pin {
  font-size: 32rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.hero__loc-text {
  flex: 1;
  min-width: 0;
}

.hero__loc-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.hero__loc-addr {
  display: block;
  font-size: 22rpx;
  opacity: 0.75;
  margin-top: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.hero__change {
  font-size: 24rpx;
  opacity: 0.85;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.hero__weather {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: rgba(255, 255, 255, 0.15);
  padding: 10rpx 18rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.hero__weather-icon { font-size: 32rpx; }
.hero__weather-temp { font-size: 28rpx; font-weight: 600; }

.hero__title {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  margin-bottom: 10rpx;
}

.hero__subtitle {
  font-size: 24rpx;
  opacity: 0.85;
  line-height: 1.5;
}

/* 筛选条件栏 */
.filter-panel {
  margin: 20rpx 24rpx 0;
  padding: 20rpx 0;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(27, 67, 50, 0.1);
  overflow: hidden;
}

.filter-panel__row {
  width: 100%;
  white-space: nowrap;
}

.filter-panel__inner {
  display: inline-flex;
  gap: 16rpx;
  padding: 0 20rpx;
}

.filter-panel__divider {
  height: 1rpx;
  margin: 16rpx 20rpx;
  background: #eef2f6;
}

.type-pill {
  flex-shrink: 0;
  padding: 14rpx 28rpx;
  font-size: 26rpx;
  color: #64748b;
  background: #f8fafc;
  border-radius: 32rpx;
  border: 2rpx solid transparent;
  white-space: nowrap;
}

.type-pill--on {
  color: #fff;
  background: linear-gradient(135deg, #2d6a4f, #40916c);
  border-color: transparent;
  box-shadow: 0 4rpx 12rpx rgba(45, 106, 79, 0.25);
}

.type-pill--popular.type-pill--on {
  background: linear-gradient(135deg, #dd6b20, #f6ad55);
}

.type-pill--niche.type-pill--on {
  background: linear-gradient(135deg, #1b4332, #40916c);
}

.type-pill--hiking.type-pill--on {
  background: linear-gradient(135deg, #1b4332, #2d6a4f);
}

/* 筛选摘要 */
.filter-bar {
  display: flex;
  align-items: center;
  margin: 16rpx 24rpx 0;
  gap: 12rpx;
}

.filter-bar__scroll { flex: 1; width: 0; }

.filter-bar__inner {
  display: inline-flex;
  gap: 12rpx;
}

.filter-tag {
  flex-shrink: 0;
  padding: 8rpx 20rpx;
  font-size: 22rpx;
  color: #2d6a4f;
  background: #d8f3dc;
  border-radius: 20rpx;
}

.filter-bar__clear {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #94a3b8;
  padding: 8rpx;
}

/* 路线列表头 */
.routes-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx 16rpx;
}

.routes-header__title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1e293b;
}

.routes-header__right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.routes-header__count {
  font-size: 24rpx;
  color: #94a3b8;
}

.routes-header__more {
  font-size: 26rpx;
  color: #2d6a4f;
  font-weight: 500;
}

/* 路线卡片 */
.routes-list {
  padding: 0 24rpx;
}

.route-card {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(27, 67, 50, 0.08);
}

.route-card--hover {
  transform: scale(0.985);
  opacity: 0.95;
}

.route-card__img-wrap {
  position: relative;
  height: 320rpx;
}

.route-card__swiper,
.route-card__img {
  width: 100%;
  height: 320rpx;
  display: block;
}

.route-card__badges {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  right: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  z-index: 2;
}

.route-card__badges-left {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  max-width: 70%;
}

.route-card__audience {
  padding: 6rpx 14rpx;
  font-size: 20rpx;
  color: #fff;
  border-radius: 8rpx;
  font-weight: 600;
}

.route-card__audience--popular { background: rgba(221, 107, 32, 0.9); }
.route-card__audience--niche { background: rgba(27, 67, 50, 0.9); }

.route-card__type {
  padding: 8rpx 18rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #fff;
  font-weight: 500;
}

.route-card__type--hiking { background: rgba(27, 67, 50, 0.85); }
.route-card__type--scenic { background: rgba(221, 107, 32, 0.85); }
.route-card__type--food { background: rgba(196, 30, 42, 0.85); }

.route-card__duration {
  padding: 8rpx 18rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #fff;
}

.route-card__img-count {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  padding: 6rpx 14rpx;
  background: rgba(0, 0, 0, 0.45);
  color: #fff;
  font-size: 20rpx;
  border-radius: 16rpx;
  z-index: 2;
}

.route-card__body {
  padding: 24rpx 28rpx 28rpx;
}

.route-card__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.route-card__name {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: #1e293b;
  line-height: 1.4;
  margin-right: 16rpx;
}

.route-card__rating {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
}

.route-card__star { color: #d69e2e; font-size: 24rpx; }
.route-card__score { font-size: 28rpx; font-weight: 600; color: #d69e2e; }

.route-card__desc {
  display: block;
  font-size: 26rpx;
  color: #64748b;
  line-height: 1.55;
  margin-bottom: 14rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.route-card__meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.route-card__district {
  font-size: 24rpx;
  color: #2d6a4f;
}

.route-card__distance {
  font-size: 24rpx;
  color: #94a3b8;
}

.route-card__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.route-card__tag {
  padding: 6rpx 16rpx;
  background: #f0f7f4;
  color: #2d6a4f;
  border-radius: 12rpx;
  font-size: 22rpx;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 48rpx;
}

.empty__icon { font-size: 80rpx; margin-bottom: 20rpx; }
.empty__text { font-size: 30rpx; color: #475569; font-weight: 500; margin-bottom: 8rpx; }
.empty__hint { font-size: 26rpx; color: #94a3b8; margin-bottom: 32rpx; text-align: center; }

.empty__btn {
  background: linear-gradient(135deg, #2d6a4f, #40916c);
  color: #fff;
  font-size: 28rpx;
  padding: 0 48rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  border: none;
}

.empty__btn::after { border: none; }
