/* pages/index/index.wxss */

.weather-card { margin-bottom: 24rpx; border-left: 6rpx solid #c41e2a; }
.weather-row { display: flex; align-items: center; }
.weather-emoji { font-size: 48rpx; margin-right: 16rpx; }
.weather-body { flex: 1; }
.weather-line { font-size: 28rpx; font-weight: 600; color: #1e293b; }
.weather-tip { font-size: 24rpx; color: #64748b; margin-top: 8rpx; }
.weather-more { font-size: 26rpx; color: #c41e2a; }
.dialect-bar { margin-top: 16rpx; font-size: 24rpx; color: #94a3b8; padding-top: 16rpx; border-top: 1rpx solid #f1f5f9; }
.route-district { font-size: 24rpx; color: #c41e2a; margin-bottom: 8rpx; }

/* 筛选面板 */
.filter-panel {
  margin-bottom: 28rpx;
  padding: 28rpx 28rpx 8rpx !important;
}

.filter-panel__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.filter-panel__title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1e293b;
}

.filter-panel__link {
  font-size: 26rpx;
  color: #c41e2a;
  padding: 8rpx 0;
}

.filter-panel__summary {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 28rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.filter-panel__tags {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.filter-panel__clear {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #94a3b8;
  padding: 8rpx 0;
  line-height: 1.4;
}

.filter-group {
  margin-bottom: 32rpx;
}

.filter-group--last {
  margin-bottom: 20rpx;
}

.filter-group__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.filter-group__label {
  display: block;
  font-size: 24rpx;
  color: #94a3b8;
  margin-bottom: 16rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
}

.filter-group__row .filter-group__label {
  margin-bottom: 0;
}

.filter-group__more {
  font-size: 24rpx;
  color: #c41e2a;
}

.filter-group__chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.filter-chip {
  padding: 14rpx 28rpx;
  font-size: 26rpx;
  color: #64748b;
  background: #f8fafc;
  border-radius: 32rpx;
  border: 2rpx solid #f1f5f9;
  line-height: 1.2;
}

.filter-chip--on {
  color: #fff;
  background: linear-gradient(135deg, #c41e2a 0%, #e53e3e 100%);
  border-color: transparent;
  box-shadow: 0 4rpx 12rpx rgba(196, 30, 42, 0.2);
}

.filter-scroll {
  width: 100%;
  margin: 0 -4rpx;
}

.filter-scroll__inner {
  display: inline-flex;
  flex-wrap: nowrap;
  gap: 16rpx;
  padding: 4rpx 4rpx 8rpx;
}

.filter-scroll .filter-chip {
  flex-shrink: 0;
}

/* 位置卡片 */
.location-card {
  margin-bottom: 24rpx;
}

.location-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.location-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.location-info {
  flex: 1;
}

.location-title {
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 4rpx;
}

.location-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1e293b;
  margin-bottom: 4rpx;
}

.location-address {
  font-size: 26rpx;
  color: #64748b;
}

.location-change {
  display: flex;
  align-items: center;
  color: #c41e2a;
  font-size: 26rpx;
  font-weight: 500;
  gap: 4rpx;
}

/* 品牌标语 */
.brand-slogan {
  background: linear-gradient(135deg, #c41e2a 0%, #e53e3e 100%);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-top: 16rpx;
  text-align: center;
}

.slogan-text {
  color: white;
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
}

/* 路线部分 */
.routes-section {
  margin-bottom: 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1e293b;
}

.section-count {
  font-size: 26rpx;
  color: #64748b;
}

/* 路线卡片 */
.route-card {
  padding: 0;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.route-image {
  position: relative;
  height: 300rpx;
  background: linear-gradient(135deg, #c41e2a 0%, #e53e3e 50%, #dd6b20 100%);
}

.route-swiper {
  width: 100%;
  height: 300rpx;
}

.route-img {
  width: 100%;
  height: 300rpx;
  display: block;
}

.route-img-count {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  z-index: 2;
  padding: 6rpx 14rpx;
  background: rgba(0, 0, 0, 0.45);
  color: #fff;
  font-size: 22rpx;
  border-radius: 20rpx;
}

.route-type-badge {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: white;
  font-weight: 500;
}

.route-type-badge.food {
  background: linear-gradient(135deg, #c41e2a 0%, #e53e3e 100%);
}

.route-type-badge.hiking {
  background: linear-gradient(135deg, #38a169 0%, #48bb78 100%);
}

.route-type-badge.scenic {
  background: linear-gradient(135deg, #dd6b20 0%, #ed8936 100%);
}

.route-duration-badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  padding: 8rpx 16rpx;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 20rpx;
  font-size: 24rpx;
  color: white;
  font-weight: 500;
}

.route-content {
  padding: 24rpx;
}

.route-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.route-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #1e293b;
  flex: 1;
  margin-right: 16rpx;
}

.route-rating {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.rating-star {
  font-size: 28rpx;
}

.rating-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #d69e2e;
}

.review-count {
  font-size: 24rpx;
  color: #64748b;
}

.route-desc {
  font-size: 28rpx;
  color: #64748b;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.route-meta {
  display: flex;
  gap: 24rpx;
  margin-bottom: 16rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: #64748b;
}

.route-highlights {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.highlight-tag {
  padding: 8rpx 16rpx;
  background: #fef2f2;
  color: #c41e2a;
  border-radius: 16rpx;
  font-size: 24rpx;
}

.route-food {
  background: #fef7f0;
  border-radius: 12rpx;
  padding: 16rpx;
}

.food-title {
  font-size: 26rpx;
  font-weight: 500;
  color: #374151;
  margin-bottom: 8rpx;
}

.food-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.food-list text {
  padding: 8rpx 16rpx;
  background: #fffaf0;
  color: #dd6b20;
  border-radius: 16rpx;
  font-size: 24rpx;
}

/* 空状态 */
.empty-state {
  padding: 80rpx 40rpx;
}

/* 响应式设计 */
@media (max-width: 750rpx) {
  .route-image {
    height: 240rpx;
  }
  
  .route-name {
    font-size: 30rpx;
  }
  
}