/* pages/filter/filter.wxss */

.filter-header {
  margin-bottom: 40rpx;
}

.filter-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #1e293b;
  margin-bottom: 8rpx;
}

.filter-subtitle {
  font-size: 28rpx;
  color: #64748b;
}

/* 筛选部分 */
.filter-section {
  margin-bottom: 40rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1e293b;
  margin-bottom: 20rpx;
}

/* 路线类型 */
.type-options {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.type-option {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  border: 2rpx solid #e2e8f0;
  transition: all 0.3s ease;
  text-align: center;
}

.type-option.active {
  border-color: #4f46e5;
  background: #eef2ff;
}

.type-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.type-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #1e293b;
  margin-bottom: 8rpx;
}

.type-desc {
  font-size: 24rpx;
  color: #64748b;
}

/* 行程时长 */
.duration-options {
  display: flex;
  gap: 16rpx;
}

.duration-option {
  flex: 1;
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  border: 2rpx solid #e2e8f0;
  transition: all 0.3s ease;
  text-align: center;
}

.duration-option.active {
  border-color: #7c3aed;
  background: #f3e8ff;
}

.duration-icon {
  font-size: 40rpx;
  margin-bottom: 12rpx;
}

.duration-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #1e293b;
  margin-bottom: 8rpx;
}

.duration-desc {
  font-size: 24rpx;
  color: #64748b;
}

/* 其他选项 */
.other-options {
  background: white;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.other-option {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.other-option:last-child {
  border-bottom: none;
}

.option-label {
  font-size: 28rpx;
  color: #374151;
}

/* 筛选预览 */
.filter-preview {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.preview-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #374151;
  margin-bottom: 8rpx;
}

.preview-count {
  font-size: 32rpx;
  font-weight: 600;
  color: #4f46e5;
  margin-bottom: 16rpx;
}

.preview-routes {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.preview-route {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx;
  background: #f8fafc;
  border-radius: 12rpx;
}

.preview-route-name {
  font-size: 26rpx;
  color: #374151;
}

.preview-route-type {
  font-size: 24rpx;
  color: #64748b;
  background: #e2e8f0;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

/* 操作按钮 */
.filter-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 40rpx;
  padding-bottom: 40rpx;
}

.filter-actions .btn {
  flex: 1;
  height: 96rpx;
}

/* 响应式设计 */
@media (max-width: 750rpx) {
  .type-options {
    grid-template-columns: 1fr;
  }
  
  .duration-options {
    flex-direction: column;
  }
  
  .filter-actions {
    flex-direction: column;
  }
}